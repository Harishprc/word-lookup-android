# Copy this file to keystore.properties (gitignored - never commit the real one).
#
# storeFile should be an ABSOLUTE path OUTSIDE this repo (e.g. a keystores
# folder in your user profile), so the real .jks is never inside the working
# tree at all, not just gitignored.
#
# Generate the keystore itself with (run this on your own machine, not in a
# sandbox - losing this file and its passwords means you can never sign an
# update to the same app again):
#
#   keytool -genkeypair -v -keystore wordlookup-release.jks -alias wordlookup ^
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
storeFile=/absolute/path/to/wordlookup-release.jks
storePassword=CHANGE_ME
keyAlias=wordlookup
keyPassword=CHANGE_ME
