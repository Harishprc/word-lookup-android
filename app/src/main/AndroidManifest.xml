    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Round 8: re-arms the review reminder's inexact AlarmManager alarm
         after a reboot - an alarm alone does not survive one. Round 5
         removed this same permission when WorkManager (its only other user)
         was deleted; it returns now for a genuinely new, independent reason,
         not a revival of anything sync-related. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- roundIcon intentionally points at ic_launcher, not ic_launcher_round:
         that is what the shipped v0.1.0 APK actually references (verified via
         tools/apk_inventory.py). ic_launcher_round exists as a resource but
         goes unreferenced there too - an authoring quirk, reproduced as-is. -->
    <application
        android:name=".WordLookupApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordLookup">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WordLookup">
            <!-- LAUNCHER lives on the activity-aliases below, not here, so the
                 launcher icon can vary by language. This MAIN-only filter is
                 inert (no LAUNCHER category, so nothing resolves to it
                 directly) - kept only so the activity still declares an entry
                 point of its own. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- One alias per supported language (see data/Languages.kt) so the
             launcher icon can show the active language's own glyph. Generated
             icons: tools/gen_lang_icons.py. Exactly one is enabled at a time,
             switched by data/LauncherIcon.kt from MainViewModel.setLanguage -
             the default-enabled one here must match Settings.targetLanguage's
             own default (Languages.DEFAULT = Kannada). -->
        <activity-alias
            android:name=".ui.LauncherAliasKn"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_kn"
            android:roundIcon="@mipmap/ic_launcher_kn"
            android:label="@string/app_name"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

