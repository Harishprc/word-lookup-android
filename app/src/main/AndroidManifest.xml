             broadcast ever reach it. -->
        <receiver
            android:name=".service.ReviewReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Round 10: same not-exported shape as ReviewReminderReceiver above,
             a separate class since the digest is a different feature (data
             source, day-of-week math, channel) with no Settings toggle. -->
        <receiver
            android:name=".service.DigestReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Round 11: unlike the two receivers above, this MUST be exported -
             the system's own APPWIDGET_UPDATE broadcast (and any other
             android.appwidget.action.* broadcast AppWidgetProvider handles)
             originates outside this app's process, from the launcher/host. -->
        <receiver
            android:name=".service.WordOfDayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.harish.wordlookup.action.CYCLE_WORD" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_word_of_day_info" />
        </receiver>

